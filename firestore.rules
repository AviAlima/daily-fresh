rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // users/{hash} is the pairing marker document for a sync code.
    // The path contains the hashed sync code, so path knowledge is the
    // capability. Read is allowed for any signed-in user (the path is the
    // secret); writes require the owner field to match the path.
    match /users/{hash} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == hash;
      allow update: if signedIn()
        && request.resource.data.owner == hash
        && resource.data.owner == hash;
      allow delete: if false;

      // users/{hash}/days/{date} — legacy per-day task documents (v2). v3 reads
      // them once during migration, then deletes them. Writes are rejected once
      // the account is on schema v3, so stale v2 clients can no longer re-create
      // docs and force re-migration churn.
      match /days/{day} {
        allow read, list: if signedIn()
          && get(/databases/$(database)/documents/users/$(hash)).data.owner == hash;
        allow create, update: if signedIn()
          && get(/databases/$(database)/documents/users/$(hash)).data.owner == hash
          && request.resource.data.size() < 200000
          && !(get(/databases/$(database)/documents/users/$(hash)).data.schema == 'v3');
        // delete must stay allowed after migration: it runs in the same batch
        // that stamps schema:'v3', and re-migration needs it to clean up any
        // docs that slipped in during the migration race window
        allow delete: if signedIn()
          && get(/databases/$(database)/documents/users/$(hash)).data.owner == hash;
      }

      // users/{hash}/open — v3 hot bundle: last 31 days in a single doc
      match /open/{doc} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/users/$(hash)).data.owner == hash;
        allow create, update: if signedIn()
          && get(/databases/$(database)/documents/users/$(hash)).data.owner == hash
          && request.resource.data.size() < 900000;
        allow delete: if false;
      }

      // users/{hash}/archive/{quarter} — v3 quarterly docs for older days
      match /archive/{quarter} {
        allow read, list: if signedIn()
          && get(/databases/$(database)/documents/users/$(hash)).data.owner == hash;
        allow create, update: if signedIn()
          && get(/databases/$(database)/documents/users/$(hash)).data.owner == hash
          && request.resource.data.size() < 900000;
        allow delete: if false;
      }

      // users/{hash}/logs/{id} — best-effort diagnostic sync log mirror
      match /logs/{id} {
        allow read, create: if signedIn()
          && get(/databases/$(database)/documents/users/$(hash)).data.owner == hash;
        allow update, delete: if false;
      }
    }
  }
}
